# OpsPilot Environment Configuration - Local Development & Test Lab
APP_NAME=OpsPilot
APP_ENV=development
DEMO_MODE=true
DEBUG=True
LOG_LEVEL=INFO

# Security Secrets (Local Development Defaults)
SECRET_KEY=opspilot-super-secret-key-change-in-production-min-32-chars
JWT_SECRET=opspilot-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for zero-config local testing, or PostgreSQL with pgvector)
# DATABASE_URL=postgresql://opspilot:opspilot_password@localhost:5432/opspilot_db
DATABASE_URL=sqlite:///./opspilot.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# When True, Celery tasks execute synchronously in-process without requiring a running Redis daemon
CELERY_ALWAYS_EAGER=True

# AI Workforce & Provider Settings
# Zero cloud requirement: System defaults to mock/deterministic offline providers
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
DEFAULT_AI_PROVIDER=deterministic
CONFIDENCE_THRESHOLD=0.80

# Optional: Developer may optionally configure OpenAI key for realistic LLM behavior
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mock Business Integrations (Never real external services)
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
EMAIL_PROVIDER=mock

# Autonomy & Action Controls
AI_WORKFORCE_ENABLED=true
AUTOMATED_ACTIONS_ENABLED=true
HIGH_RISK_ACTIONS_ENABLED=true
GLOBAL_AI_KILL_SWITCH=false

# Local Storage
STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=25

# Server & Networking
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
